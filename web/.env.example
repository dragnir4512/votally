# Adresse de l'API (côté serveur Next uniquement)
API_URL=http://localhost:3000
# Domaine racine pour les sous-domaines de concours : slug.<domaine>. En local : localhost:3001 (ex. http://miss-demo.localhost:3001)
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3001
# Mode test : affiche le bouton « Simuler le paiement » (nécessite l'API hors production). Mettre 0 en production.
NEXT_PUBLIC_DEV_MOCK=1
# Adresse publique des images (stockage objet / CDN), quand les images seront en ligne. Vide = vignettes à initiales.
NEXT_PUBLIC_MEDIA_URL=
