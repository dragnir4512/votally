# --- Base de données ---
DATABASE_URL=postgres://votally:votally@localhost:5432/votally

# --- API (obligatoires, 16 caractères minimum) ---
JWT_SECRET=remplace-moi-par-une-longue-chaine-aleatoire
# Poivre des numéros de téléphone : NE JAMAIS le committer, NE JAMAIS le perdre ni le changer
PHONE_HASH_PEPPER=remplace-moi-par-un-autre-secret-aleatoire

# --- API (facultatifs) ---
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3001
FEE_RATE_BPS=250
PAYMENT_PROVIDER=mock
MOCK_WEBHOOK_SECRET=mock-secret-change-me
# --- Notch Pay : paiements entrants ---
# Renseigner uniquement avec les clés Sandbox pendant les tests.
NOTCHPAY_PUBLIC_KEY=
NOTCHPAY_HASH_KEY=
NOTCHPAY_CALLBACK_URL=
BCRYPT_COST=12
# Dossier des fichiers téléversés (photos, pièces KYC) ; ignoré par Git
UPLOAD_DIR=./uploads

# --- Site web : voir web/.env.example (à copier dans web/.env.local) ---
